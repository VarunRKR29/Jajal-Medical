{
  "info": {
    "_postman_id": "c1f7a432-8591-4cf1-9be3-d92e1069f54b",
    "name": "MedCase API - Medical Case Management",
    "description": "Collection of REST API endpoints for MedCase implant tracking system at Jajal Medical.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000",
      "type": "string"
    },
    {
      "key": "authToken",
      "value": "sanctum_admin_token_001_seed",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "Authentication",
      "item": [
        {
          "name": "POST Login (Admin)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@jajalmedical.com\",\n  \"password\": \"Password123!\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/login",
              "host": ["{{baseUrl}}"],
              "path": ["api", "login"]
            }
          }
        },
        {
          "name": "POST Login (Viewer)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"viewer@jajalmedical.com\",\n  \"password\": \"Password123!\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/login",
              "host": ["{{baseUrl}}"],
              "path": ["api", "login"]
            }
          }
        },
        {
          "name": "POST Logout",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{authToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/logout",
              "host": ["{{baseUrl}}"],
              "path": ["api", "logout"]
            }
          }
        }
      ]
    },
    {
      "name": "Medical Cases",
      "item": [
        {
          "name": "GET Cases List (Paginated, Search, Filter)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{authToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/cases?page=1&per_page=10&search=&status=&priority=&sort_by=id&sort_direction=desc",
              "host": ["{{baseUrl}}"],
              "path": ["api", "cases"],
              "query": [
                { "key": "page", "value": "1" },
                { "key": "per_page", "value": "10" },
                { "key": "search", "value": "" },
                { "key": "status", "value": "" },
                { "key": "priority", "value": "" },
                { "key": "sort_by", "value": "id" },
                { "key": "sort_direction", "value": "desc" }
              ]
            }
          }
        },
        {
          "name": "POST Create Case (Admin / Engineer)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{authToken}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"case_number\": \"CASE-0099\",\n  \"patient_reference\": \"PT-55102\",\n  \"surgeon_name\": \"Dr. Marcus Sterling\",\n  \"implant_type\": \"Custom PEEK Cranial Flap\",\n  \"status\": \"Planning\",\n  \"priority\": \"High\",\n  \"surgery_date\": \"2026-11-15\",\n  \"notes\": \"Bilateral temporal defect reconstruction\",\n  \"hospital_site\": \"St. Jude Neurological\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/cases",
              "host": ["{{baseUrl}}"],
              "path": ["api", "cases"]
            }
          }
        },
        {
          "name": "GET Single Case",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{authToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/cases/1",
              "host": ["{{baseUrl}}"],
              "path": ["api", "cases", "1"]
            }
          }
        },
        {
          "name": "PUT Update Case (Admin / Engineer)",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{authToken}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"case_number\": \"CASE-0001\",\n  \"patient_reference\": \"PT-98214\",\n  \"surgeon_name\": \"Dr. Robert Sterling\",\n  \"implant_type\": \"Patient-Specific Cranial Titanium Mesh\",\n  \"status\": \"Approved\",\n  \"priority\": \"High\",\n  \"surgery_date\": \"2026-10-28\",\n  \"notes\": \"Updated: Surgical plan verified and pre-op clearance completed.\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/cases/1",
              "host": ["{{baseUrl}}"],
              "path": ["api", "cases", "1"]
            }
          }
        },
        {
          "name": "DELETE Case (Admin Only)",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{authToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/cases/1",
              "host": ["{{baseUrl}}"],
              "path": ["api", "cases", "1"]
            }
          }
        }
      ]
    },
    {
      "name": "Utilities & Integrations",
      "item": [
        {
          "name": "GET Public Holidays (Nager.Date Integration)",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/holidays?year=2026&country=US",
              "host": ["{{baseUrl}}"],
              "path": ["api", "holidays"],
              "query": [
                { "key": "year", "value": "2026" },
                { "key": "country", "value": "US" }
              ]
            }
          }
        },
        {
          "name": "POST Reset Database to Seed State",
          "request": {
            "method": "POST",
            "url": {
              "raw": "{{baseUrl}}/api/reset-db",
              "host": ["{{baseUrl}}"],
              "path": ["api", "reset-db"]
            }
          }
        }
      ]
    }
  ]
}
